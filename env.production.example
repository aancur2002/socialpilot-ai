# SocialPilot production settings for docker-compose.prod.yml.
# Copy to .env on the server and fill in every value marked REQUIRED.
# Never commit the filled-in file.

# ── Domain and HTTPS ─────────────────────────────────────────────
# REQUIRED. The domain customers use, with its DNS A/AAAA record pointing at this server.
DOMAIN=app.example.com
# REQUIRED. Let's Encrypt sends certificate notices here.
ACME_EMAIL=you@example.com

# ── Secrets (REQUIRED; generate each with: openssl rand -base64 32) ──
# Keep a copy of ENCRYPTION_KEY somewhere safe: without it, saved social tokens and
# API keys can't be decrypted and every account must reconnect.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
JWT_SECRET=
# Passwords for the internal database and Redis (letters and digits only avoids URL escaping).
POSTGRES_PASSWORD=
REDIS_PASSWORD=
POSTGRES_USER=socialpilot
POSTGRES_DB=socialpilot

# ── AI (REQUIRED: the default for every customer; each can override in Settings → AI models) ──
# anthropic | openai | google | nvidia | meta
AI_PROVIDER=google
AI_API_KEY=
AI_MODEL=
AI_FAST_MODEL=
# openai | google | nvidia (Meta and Anthropic have no embeddings)
EMBEDDING_PROVIDER=google
EMBEDDING_API_KEY=

# ── Storage ──────────────────────────────────────────────────────
# local = uploaded images on this server's disk (included in backups). Fine for one server.
# s3 = any S3-compatible bucket (AWS, Cloudflare R2, Backblaze, Wasabi) for several servers.
STORAGE_DRIVER=local
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=

# ── Backups ──────────────────────────────────────────────────────
# Folder on this server for daily backups. Copy it off the server too (see docs/deployment.md).
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24

# ── Social platform app credentials ─────────────────────────────
# Easier: enter them in Platform admin → Integrations after the first sign-in.
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# ── Email, company details, legal pages, card payments ───────────
# Set in Platform admin (Email, Company & legal, Payments). Nothing needed here.

# ── Limits ───────────────────────────────────────────────────────
API_RATE_LIMIT_PER_MINUTE=300
SESSION_TTL_HOURS=168
