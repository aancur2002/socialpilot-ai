# ─────────────────────────────────────────────────────────────────────────────
# SocialPilot AI — environment configuration template
#   cp env.example .env
# Fill in values. NEVER commit a real `.env`.
# Every variable is validated at startup by packages/config (zod).
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
# Deployment label (local | staging | production). Mock social providers are
# refused when APP_ENV=production or NODE_ENV=production.
APP_ENV=local

# ── Core infrastructure ─────────────────────────────────────────────────────
# Postgres 16 + pgvector (docker-compose exposes it on 5434)
DATABASE_URL=postgresql://socialpilot:socialpilot@localhost:5434/socialpilot?schema=public
REDIS_URL=redis://localhost:6380

# ── URLs ────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Public HTTPS base URL platforms deliver webhooks to (use a tunnel such as
# cloudflared/ngrok in development). Webhook paths: /webhooks/<platform>
WEBHOOK_BASE_URL=http://localhost:4000
API_PORT=4000
# Comma-separated origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000

# ── Secrets ─────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Encrypts OAuth tokens at rest (AES-256-GCM).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Current key version label stored with every ciphertext
ENCRYPTION_KEY_VERSION=1
# Previous keys kept for decryption during rotation: "version:base64key,..."
ENCRYPTION_KEY_PREVIOUS=
# >= 32 random characters. Signs OAuth state and internal tokens.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_TTL_HOURS=168

# ── AI provider ─────────────────────────────────────────────────────────────
# anthropic | openai | google | nvidia | meta | mock   (mock = deterministic offline provider, dev/tests)
#   google = Gemini API (free tier key: aistudio.google.com), nvidia = NVIDIA NIM (free credits: build.nvidia.com)
#   meta = Meta Model API, Muse Spark (key: dev.meta.ai). No embeddings: pair with EMBEDDING_PROVIDER=google or nvidia
# Each organization can also choose its own provider/model/key in Settings → AI models.
AI_PROVIDER=mock
AI_API_KEY=
# Optional model overrides (sensible defaults per provider)
AI_MODEL=
AI_FAST_MODEL=
# Embeddings: openai | google | nvidia | mock  (Anthropic has no embeddings endpoint; "mock" is a
# deterministic local hashing embedder that works offline — lexical quality only)
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Base URL for OpenAI-compatible APIs (optional)
OPENAI_BASE_URL=

# ── Object storage (S3-compatible) ──────────────────────────────────────────
# s3 | local   (local writes to ./.data/storage — development only)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
# Public base URL for objects (CDN/bucket URL). Platforms fetch media from here.
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# ── Social integrations ─────────────────────────────────────────────────────
# Enables Mock* adapters (MockFacebook, MockInstagram, ...). Refused in production.
SOCIAL_MOCK_MODE=true

# Meta — Facebook Pages (https://developers.facebook.com/apps)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0

# Instagram (Instagram API with Instagram Login)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# WhatsApp Business Platform (Cloud API, via a Meta app)
WHATSAPP_CLIENT_ID=
WHATSAPP_CLIENT_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Embedded Signup configuration id (Facebook Login for Business)
WHATSAPP_CONFIG_ID=

# LinkedIn (https://www.linkedin.com/developers/apps)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202509
# Request Community Management scopes (organization pages). Only after LinkedIn approves your app.
LINKEDIN_ORGANIZATION_SCOPES=false

# TikTok (https://developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Email notification delivery (optional) ─────────────────────────────────
# log | smtp   (log = write emails to the worker log)
EMAIL_DRIVER=log
SMTP_URL=
EMAIL_FROM="SocialPilot AI <no-reply@example.com>"

# ── Operations ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Default max publishing attempts (per-client override allowed, 1..10)
PUBLISH_MAX_ATTEMPTS=3
# API rate limit per IP per minute
API_RATE_LIMIT_PER_MINUTE=300
