    "@fastify/swagger-ui": "6.1.2",
    "@socialpilot/ai": "0.1.0",
    "@socialpilot/auth": "0.1.0",
    "@socialpilot/config": "0.1.0",
    "@socialpilot/core": "0.1.0",
    "@socialpilot/database": "0.1.0",
