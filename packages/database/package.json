{
  "name": "@socialpilot/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "node scripts/prisma.mjs migrate deploy",
    "migrate:deploy": "node scripts/prisma.mjs migrate deploy",
    "reset": "node scripts/prisma.mjs migrate reset --force --skip-seed",
    "typecheck": "tsc -p tsconfig.json",
    "migrate:new": "node scripts/create-migration.mjs"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@socialpilot/config": "0.1.0"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
